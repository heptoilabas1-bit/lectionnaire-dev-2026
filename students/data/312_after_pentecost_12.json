,{"greek":"λόγον","gloss":"parole"},{"greek":"ἀπῆλθεν","gloss":"il_s'en_alla"},{"greek":"λυπούμενος·","gloss":"étant_attristé"},{"greek":"ἦν","gloss":"il_était"},{"greek":"γὰρ","gloss":"car"},{"greek":"ἔχων","gloss":"ayant"},{"greek":"κτήματα","gloss":"des_acquisitions/possessions"},{"greek":"πολλά.","gloss":"nombreuses"}]},{"verse_number":23,"translations":{"segond":"Jésus dit à ses disciples : Je vous le dis en vérité, un riche entrera difficilement dans le royaume des cieux.","darby":"Et Jésus dit à ses disciples : En vérité, je vous dis qu'un riche entrera difficilement dans le royaume des cieux."},"interlinear":[{"greek":"ὁ","gloss":"Le/—"},{"greek":"δὲ","gloss":"or"},{"greek":"Ἰησοῦς","gloss":"Jésus"},{"greek":"εἶπεν","gloss":"dit"},{"greek":"τοῖς","gloss":"aux"},{"greek":"μαθηταῖς","gloss":"disciples"},{"greek":"αὐτοῦ·","gloss":"de_lui"},{"greek":"Ἀμὴν","gloss":"En_vérité/Amen"},{"greek":"λέγω","gloss":"je_dis"},{"greek":"ὑμῖν","gloss":"à_vous"},{"greek":"ὅτι","gloss":"qu'"},{"greek":"πλούσιος","gloss":"un_riche"},{"greek":"δυσκόλως","gloss":"difficilement/avec_peine"},{"greek":"εἰσελεύσεται","gloss":"entrera"},{"greek":"εἰς","gloss":"dans"},{"greek":"τὴν","gloss":"le"},{"greek":"βασιλείαν","gloss":"royaume"},{"greek":"τῶν","gloss":"des"},{"greek":"οὐρανῶν.","gloss":"cieux"}]},{"verse_number":24,"translations":{"segond":"Je vous le dis encore, il est plus facile à un chameau de passer par le trou d'une aiguille qu'à un riche d'entrer dans le royaume de Dieu.","darby":"Et je vous le dis encore : Il est plus facile qu'un chameau passe par le trou d'une aiguille, qu'un riche n'entre dans le royaume de Dieu."},"interlinear":[{"greek":"πάλιν","gloss":"De_nouveau/Encore"},{"greek":"δὲ","gloss":"or"},{"greek":"λέγω","gloss":"je_dis"},{"greek":"ὑμῖν,","gloss":"à_vous"},{"greek":"εὐκοπώτερόν","gloss":"plus_facile"},{"greek":"ἐστιν","gloss":"il_est"},{"greek":"κάμηλον","gloss":"un_chameau"},{"greek":"διὰ","gloss":"à_travers"},{"greek":"τρυπήματος","gloss":"le_trou/la_p