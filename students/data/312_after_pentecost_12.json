inthiens 15, 1-11","title":"L'Évangile de la résurrection du Christ","interlinear":[{"verse_number":1,"translations":{"segond":"Je vous rappelle, frères, l'Évangile que je vous ai annoncé, que vous avez reçu, dans lequel vous avez persévéré,","darby":"Or je vous fais savoir, frères, l'évangile que je vous ai annoncé, que vous avez aussi reçu, et dans lequel vous êtes fermes,"},"interlinear":[{"greek":"Γνωρίζω","gloss":"Je_fais_savoir/Je_rappelle"},{"greek":"δὲ","gloss":"or"},{"greek":"ὑμῖν,","gloss":"à_vous"},{"greek":"ἀδελφοί,","gloss":"frères"},{"greek":"τὸ","gloss":"l'"},{"greek":"εὐαγγέλιον","gloss":"évangile"},{"greek":"ὃ","gloss":"que"},{"greek":"εὐηγγελισάμην","gloss":"j'ai_annoncé"},{"greek":"ὑμῖν,","gloss":"à_vous"},{"greek":"ὃ","gloss":"que"},{"greek":"καὶ","gloss":"aussi"},{"greek":"παρελάβετε,","gloss":"vous_avez_reçu"},{"greek":"ἐν","gloss":"dans"},{"greek":"ᾧ","gloss":"lequel"},{"greek":"καὶ","gloss":"aussi"},{"greek":"ἑστήκατε,","gloss":"vous_vous_tenez_debout"}]},{"verse_number":2,"translations":{"segond":"et par lequel vous êtes sauvés, si vous le retenez tel que je vous l'ai annoncé ; autrement, vous auriez cru en vain.","darby":"et par lequel vous êtes sauvés, si vous le retenez tel que je vous l'ai annoncé, à moins que vous n'ayez cru en vain."},"interlinear":[{"greek":"δι’","gloss":"par"},{"greek":"οὗ","gloss":"lequel"},{"greek":"καὶ","gloss":"aussi"},{"greek":"σῴζεσθε,","gloss":"vous_êtes_sauvés"},{"greek":"τίνι","gloss":"par_quelle"},{"greek":"λόγῳ","gloss":"parole"},{"greek":"εὐηγγελισάμην","gloss":"j'ai_annoncé"},{"greek":"ὑμῖν","gloss":"à_vous"},{"greek":"εἰ","gloss":"si"},{"greek":"κατέχετε,","gloss":"vous_retenez"},{"greek":"ἐκτὸς","gloss":"à_moins"},{"greek":"εἰ","gloss":"si"},{"greek":"μὴ","gloss":"non"},{"greek":"εἰκῇ","gloss":"en_vain/sans_raison"},{"greek":"ἐπιστεύσατε.","gloss":"vous_avez_cru"}]},{"verse_number":3,"translations":{"segond":"Je vous ai enseigné avant tout, comme je l'avais aussi reçu, que Christ est mort pour nos péchés, selon les Écritures ;","darby":"Car je vous ai communiqué avant toutes choses ce que j'ai aussi reçu, que Christ est mort pour nos péchés, selon les écritures ;"},"interlinear":[{"greek":"παρέδωκα","gloss":"J'ai_transmis"},{"greek":"γὰρ","gloss":"car"},{"greek":"ὑμῖν","gloss":"à_vous"},{"greek":"ἐν","gloss":"en"},{"greek":"πρώτοις,","gloss":"premiers/avant_tout"},{"greek":"ὃ","gloss":"ce_que"},{"greek":"καὶ","gloss":"aussi"},{"greek":"παρέλαβον,","gloss":"j'ai_reçu"},{"greek":"ὅτι","gloss":"que"},{"greek":"Χριστὸς","gloss":"Christ"},{"greek":"ἀπέθανεν","gloss":"est_mort"},{"greek":"ὑπὲρ","gloss":"pour"},{"greek":"τῶν","gloss":"les"},{"greek":"ἁμαρτιῶν","gloss":"péchés"},{"greek":"ἡμῶν","gloss":"de_nous"},{"greek":"κατὰ","gloss":"selon"},{"greek":"τὰς","gloss":"les"},{"greek":"γραφάς,","gloss":"écritures"}]},{"verse_number":4,"translations":{"segond":"qu'il a été enseveli, et qu'il est ressuscité le troisième jour, selon les Écritures ;","darby":"et qu'il a été enseveli, et qu'il a été ressuscité le troisième jour, selon les écritures ;"},"interlinear":[{"greek":"καὶ","gloss":"et"},{"greek":"ὅτι","gloss":"qu'"},{"greek":"ἐτάφη,","gloss":"il_a_été_enseveli"},{"greek":"καὶ","gloss":"et"},{"greek":"ὅτι","gloss":"qu'"},{"greek":"ἐγήγερται","gloss":"il_a_été_réveillé/ressuscité"},{"greek":"τῇ","gloss":"le"},{"greek":"ἡμέρᾳ","gloss":"jour"},{"greek":"τῇ","gloss":"le"},{"greek":"τρίτῃ","gloss":"troisième"},{"greek":"κατὰ","gloss":"selon"},{"greek":"τὰς","gloss":"les"},{"greek":"γραφάς,","gloss":"écritures"}]},{"verse_number":5,"translations":{"segond":"et qu'il est apparu à Céphas, puis aux douze.","darby":"et qu'il a été vu de Céphas, puis des douze."},"interlinear":[{"greek":"καὶ","gloss":"et"},{"greek":"ὅτι","gloss":"qu'"},{"greek":"ὤφθη","gloss":"il_est_apparu/a_été_vu"},{"greek":"Κηφᾷ,","gloss":"à_Céphas"},{"greek":"εἶτα","gloss":"ensuite"},{"greek":"τοῖς","gloss":"aux"},{"greek":"δώδεκα·","gloss":"douze"}]},{"verse_number":6,"translations":{"segond":"Ensuite, il est apparu à plus de cinq cents frères à la fois, de qui la plupart sont encore vivants, et dont quelques-uns sont morts.","darby":"Ensuite il a été vu de plus de cinq cents frères à la fois, dont la plupart sont demeurés en vie jusqu'à présent, mais quelques-uns aussi s'en sont endormis."},"interlinear":[{"greek":"ἔπειτα","gloss":"Ensuite"},{"greek":"ὤφθη","gloss":"il_est_apparu"},{"greek":"ἐπάνω","gloss":"à_plus_de"},{"greek":"πεντακοσίοις","gloss":"cinq_cents"},{"greek":"ἀδελφοῖς","gloss":"frères"},{"greek":"ἐφάπαξ,","gloss":"à_la_fois"},{"greek":"ἐξ","gloss":"parmi"},{"greek":"ὧν","gloss":"lesquels"},{"greek":"οἱ","gloss":"les"},{"greek":"πλείονες","gloss":"plus_nombreux"},{"greek":"μένουσιν","gloss":"demeurent/restent"},{"greek":"ἕως","gloss":"jusqu'à"},{"greek":"ἄρτι,","gloss":"maintenant"},{"greek":"τινὲς","gloss":"quelques-uns"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐκοιμήθησαν·","gloss":"se_sont_endormis"}]},{"verse_number":7,"translations":{"segond":"Ensuite, il est apparu à Jacques, puis à tous les apôtres ;","darby":"Ensuite il a été vu de Jacques, puis de tous les apôtres ;"},"interlinear":[{"greek":"ἔπειτα","gloss":"Ensuite"},{"greek":"ὤφθη","gloss":"il_est_apparu/fut_vu"},{"greek":"Ἰακώβῳ,","gloss":"à_Jacques"},{"greek":"εἶτα","gloss":"puis"},{"greek":"τοῖς","gloss":"aux"},{"greek":"ἀποστόλοις","gloss":"apôtres"},{"greek":"πᾶσιν·","gloss":"tous"}]},{"verse_number":8,"translations":{"segond":"Après eux tous, il m'est aussi apparu à moi, comme à l'avorton ;","darby":"et, après tous, il a été vu de moi aussi, comme de l'avorton."},"interlinear":[{"greek":"ἔσχατον","gloss":"en_dernier"},{"greek":"δὲ","gloss":"or/et"},{"greek":"πάντων","gloss":"de_tous"},{"greek":"ὡσπερεὶ","gloss":"comme_si/comme"},{"greek":"τῷ","gloss":"l'"},{"greek":"ἐκτρώματι","gloss":"avorton"},{"greek":"ὤφθη","gloss":"il_est_apparu"},{"greek":"κἀμοί.","gloss":"aussi_à_moi"}]},{"verse_number":9,"translations":{"segond":"car je suis le moindre des apôtres, je ne suis pas digne d'être appelé apôtre, parce que j'ai persécuté l'Église de Dieu.","darby":"Car moi, je suis le moindre des apôtres, qui ne suis pas digne d'être appelé apôtre, parce que j'ai persécuté l'assemblée de Dieu ;"},"interlinear":[{"greek":"Ἐγὼ","gloss":"Moi"},{"greek":"γάρ","gloss":"car"},{"greek":"εἰμι","gloss":"je_suis"},{"greek":"ὁ","gloss":"le"},{"greek":"ἐλάχιστος","gloss":"moindre/plus_petit"},{"greek":"τῶν","gloss":"des"},{"greek":"ἀποστόλων,","gloss":"apôtres"},{"greek":"ὃς","gloss":"qui"},{"greek":"οὐκ","gloss":"ne...pas"},{"greek":"εἰμὶ","gloss":"je_suis"},{"greek":"ἱκανὸς","gloss":"suffisant/digne"},{"greek":"καλεῖσθαι","gloss":"d'être_appelé"},{"greek":"ἀπόστολος,","gloss":"apôtre"},{"greek":"διότι","gloss":"parce_que"},{"greek":"ἐδίωξα","gloss":"j'ai_persécuté"},{"greek":"τὴν","gloss":"l'"},{"greek":"ἐκκλησίαν","gloss":"Église/assemblée"},{"greek":"τοῦ","gloss":"de"},{"greek":"θεοῦ·","gloss":"Dieu"}]},{"verse_number":10,"translations":{"segond":"Par la grâce de Dieu je suis ce que je suis, et sa grâce envers moi n'a pas été vaine ; loin de là, j'ai travaillé plus qu'eux tous, non pas moi toutefois, mais la grâce de Dieu qui est avec moi.","darby":"mais par la grâce de Dieu, je suis ce que je suis ; et sa grâce envers moi n'a pas été vaine, mais j'ai travaillé beaucoup plus qu'eux tous, non pas moi toutefois, mais la grâce de Dieu qui est avec moi."},"interlinear":[{"greek":"χάριτι","gloss":"Par_la_grâce"},{"greek":"δὲ","gloss":"or/mais"},{"greek":"θεοῦ","gloss":"de_Dieu"},{"greek":"εἰμι","gloss":"je_suis"},{"greek":"ὅ","gloss":"ce_que"},{"greek":"εἰμι,","gloss":"je_suis"},{"greek":"καὶ","gloss":"et"},{"greek":"ἡ","gloss":"la"},{"greek":"χάρις","gloss":"grâce"},{"greek":"αὐτοῦ","gloss":"de_lui"},{"greek":"ἡ","gloss":"celle"},{"greek":"εἰς","gloss":"envers"},{"greek":"ἐμὲ","gloss":"moi"},{"greek":"οὐ","gloss":"ne...pas"},{"greek":"κενὴ","gloss":"vaine/vide"},{"greek":"ἐγενήθη,","gloss":"a_été"},{"greek":"ἀλλὰ","gloss":"mais"},{"greek":"περισσότερον","gloss":"plus_abondam