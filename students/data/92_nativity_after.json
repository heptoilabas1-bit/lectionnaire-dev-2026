greek":"Τελευτήσαντος","gloss":"Ayant_atteint_sa_fin/Étant_mort"},{"greek":"δὲ","gloss":"or"},{"greek":"τοῦ","gloss":"le"},{"greek":"Ἡρῴδου","gloss":"Hérode"},{"greek":"ἰδοὺ","gloss":"voici"},{"greek":"ἄγγελος","gloss":"un_ange"},{"greek":"κυρίου","gloss":"du_Seigneur"},{"greek":"φαίνεται","gloss":"apparaît"},{"greek":"κατ’","gloss":"en/selon"},{"greek":"ὄναρ","gloss":"songe"},{"greek":"τῷ","gloss":"à_le"},{"greek":"Ἰωσὴφ","gloss":"Joseph"},{"greek":"ἐν","gloss":"dans"},{"greek":"Αἰγύπτῳ","gloss":"l'Égypte"}]},{"verse_number":20,"translations":{"segond":"et dit : Lève-toi, prends le petit enfant et sa mère, et va dans le pays d'Israël, car ceux qui en voulaient à la vie du petit enfant sont morts.","darby":"Lève-toi, prends le petit enfant et sa mère, et va dans le pays d'Israël ; car ceux qui cherchaient la vie du petit enfant sont morts."},"interlinear":[{"greek":"λέγων·","gloss":"disant"},{"greek":"Ἐγερθεὶς","gloss":"T'étant_levé/Ressuscité"},{"greek":"παράλαβε","gloss":"prends_auprès_de_toi"},{"greek":"τὸ","gloss":"le"},{"greek":"παιδίον","gloss":"petit_enfant"},{"greek":"καὶ","gloss":"et"},{"greek":"τὴν","gloss":"la"},{"greek":"μητέρα","gloss":"mère"},{"greek":"αὐτοῦ","gloss":"de_lui"},{"greek":"καὶ","gloss":"et"},{"greek":"πορεύου","gloss":"fais_route/va"},{"greek":"εἰς","gloss":"vers/dans"},{"greek":"γῆν","gloss":"la_terre"},{"greek":"Ἰσραήλ·","gloss":"d'Israël"},{"greek":"τεθνήκασιν","gloss":"sont_morts"},{"greek":"γὰρ","gloss":"car"},{"greek":"οἱ","gloss":"ceux"},{"greek":"ζητοῦντες","gloss":"cherchant"},{"greek":"τὴν","gloss":"la"},{"greek":"ψυχὴν","gloss":"vie/âme"},{"greek":"τοῦ","gloss":"du"},{"greek":"παιδίου.","gloss":"petit_enfant"}]},{"verse_number":21,"translations":{"segond":"Joseph se leva, prit le petit enfant et sa mère, et alla dans le pays d'Israël.","darby":"Et lui, s'étant levé, prit le petit enfant et sa mère, et vint dans le pays d'Israël."},"interlinear":[{"greek":"Ὁ","gloss":"Lui"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐγερθεὶς","gloss":"s'étant_levé"},{"greek":"παρέλαβεν","gloss":"prit"},{"greek":"τὸ","gloss":"le"},{"greek":"παιδίον","gloss":"petit_enfant"},{"greek":"καὶ","gloss":"et"},{"greek":"τὴν","gloss":"la"},{"greek":"μητέρα","gloss":"mère"},{"greek":"αὐτοῦ","gloss":"de_lui"},{"greek":"καὶ","gloss":"et"},{"greek":"εἰσῆλθεν","gloss":"entra"},{"greek":"εἰς","gloss":"dans"},{"greek":"γῆν","gloss":"la_terre"},{"greek":"Ἰσραήλ.","gloss":"d'Israël"}]},{"verse_number":22,"translations":{"segond":"Mais, ayant appris qu'Archélaüs régnait sur la Judée à la place d'Hérode, son père, il craignit d'y aller ; et, divinement averti en songe, il se retira dans le territoire de la Galilée,","darby":"Mais, entendant qu'Archélaüs régnait sur la Judée à la place d'Hérode son père, il craignit d'y aller ; et, averti divinement en songe, il se retira dans les quartiers de la Galilée ;"},"interlinear":[{"greek":"ἀκούσας","gloss":"Ayant_entendu"},{"greek":"δὲ","gloss":"or"},{"greek":"ὅτι","gloss":"qu'"},{"greek":"Ἀρχέλαος","gloss":"Archélaüs"},{"greek":"βασιλεύει","gloss":"règne"},{"greek":"τῆς","gloss":"sur_la"},{"greek":"Ἰουδαίας","gloss":"Judée"},{"greek":"ἀντὶ","gloss":"à_la_place_de"},{"greek":"τοῦ","gloss":"le"},{"greek":"πατρὸς","gloss":"père"},{"greek":"αὐτοῦ","gloss":"de_lui"},{"greek":"Ἡρῴδου","gloss":"Hérode"},{"greek":"ἐφοβήθη","gloss":"il_craignit/eut_peur"},{"greek":"ἐκεῖ","gloss":"là"},{"greek":"ἀπελθεῖν·","gloss":"d'aller"},{"greek":"χρηματισθεὶς","gloss":"ayant_été_divinement_averti"},{"greek":"δὲ","gloss":"or"},{"greek":"κατ’","gloss":"en"},{"greek":"ὄναρ","gloss":"songe"},{"greek":"ἀνεχώρησεν","gloss":"il_se_retira"},{"greek":"εἰς","gloss":"vers/dans"},{"greek":"τὰ","gloss":"les"},{"greek":"μέρη","gloss":"parties/quartiers"},{"greek":"τῆς","gloss":"de_la"},{"greek":"Γαλιλαίας,","gloss":"Galilée"}]},{"verse_number":23,"translations":{"segond":"et vint demeurer dans une ville appelée Nazareth, afin que s'accomplît ce qui avait été annoncé par les prophètes : Il sera appelé Nazaréen.","darby":"et vint et demeura dans une ville appelée Nazareth ; de sorte que fût accompli ce qui a été dit par les prophètes : Il sera appelé Nazaréen."},"interlinear":[{"greek":"καὶ","gloss":"Et"},{"greek":"ἐλθὼν","gloss":"étant_venu"},{"greek":"κατῴκησεν","gloss":"il_habita/s'établit"},{"greek":"εἰς","gloss":"dans"},{"greek":"πόλιν","gloss":"une_ville"},{"greek":"λεγομένην","gloss":"étant_appelée"},{"greek":"Ναζαρέτ·","gloss":"Nazareth"},{"greek":"ὅπως","gloss":"de_sorte_que"},{"greek":"πληρωθῇ","gloss":"soit_accompli/rempli"},{"greek":"τὸ","gloss":"ce_qui"},{"greek":"ῥηθὲν","gloss":"a_été_dit"},{"greek":"διὰ","gloss":"à_travers"},{"greek":"τῶν","gloss":"les"},{"greek":"προφητῶν","gloss":"prophètes"},{"greek":"ὅτι","gloss":"que"},{"greek":"Ναζωραῖος","gloss":"Nazaréen"},{"greek":"κληθήσεται.","gloss":"il_sera_appelé"}]}]},"apostle":{"reference":"Galates 1, 11-19","title":"L'Évangile annoncé par Paul","interlinear":[{"verse_number":11,"translations":{"segond":"Je vous déclare, frères, que l'Évangile qui a été annoncé par moi n'est pas de l'homme,","darby":"Or je vous fais savoir, frères, quant à l'évangile qui a été annoncé par moi, qu'il n'est pas selon l'homme ;"},"interlinear":[{"greek":"Γνωρίζω","gloss":"Je_fais_connaître"},{"greek":"γὰρ","gloss":"car"},{"greek":"ὑμῖν,","gloss":"à_vous"},{"greek":"ἀδελφοί,","gloss":"frères"},{"greek":"τὸ","gloss":"le"},{"greek":"εὐαγγέλιον","gloss":"Évangile/Bonne_Nouvelle"},{"greek":"τὸ","gloss":"qui"},{"greek":"εὐαγγελισθὲν","gloss":"a_été_annoncé"},{"greek":"ὑπ’","gloss":"par"},{"greek":"ἐμοῦ","gloss":"moi"},{"greek":"ὅτι","gloss":"que"},{"greek":"οὐκ","gloss":"ne...pas"},{"greek":"ἔστιν","gloss":"est"},{"greek":"κατὰ","gloss":"selon"},{"greek":"ἄνθρωπον·","gloss":"l'homme"}]},{"verse_number":12,"translations":{"segond":"car je ne l'ai ni reçu ni appris d'aucun homme, mais je l'ai reçu par une révélation de Jésus-Christ.","darby":"car moi, je ne l'ai ni reçu ni appris d'un homme, mais par une révélation de Jésus Christ."},"interlinear":[{"