ercenaires/journaliers"},{"greek":"τοῦ","gloss":"de_le"},{"greek":"πατρός","gloss":"père"},{"greek":"μου","gloss":"de_moi"},{"greek":"περισσεύουσιν","gloss":"ont_en_abondance"},{"greek":"ἄρτων,","gloss":"de_pains"},{"greek":"ἐγὼ","gloss":"moi"},{"greek":"δὲ","gloss":"or/mais"},{"greek":"λιμῷ","gloss":"par_faim"},{"greek":"ὧδε","gloss":"ici"},{"greek":"ἀπόλλυμαι·","gloss":"je_péris"}]},{"verse_number":18,"translations":{"segond":"Je me lèverai, j'irai vers mon père, et je lui dirai : Mon père, j'ai péché contre le ciel et contre toi,","darby":"Je me lèverai et j'irai vers mon père, et je lui dirai : Père, j'ai péché contre le ciel et devant toi ;"},"interlinear":[{"greek":"ἀναστὰς","gloss":"M'étant_levé"},{"greek":"πορεύσομαι","gloss":"j'irai"},{"greek":"πρὸς","gloss":"vers"},{"greek":"τὸν","gloss":"le"},{"greek":"πατέρα","gloss":"père"},{"greek":"μου","gloss":"de_moi"},{"greek":"καὶ","gloss":"et"},{"greek":"ἐρῶ","gloss":"je_dirai"},{"greek":"αὐτῷ·","gloss":"à_lui"},{"greek":"Πάτερ,","gloss":"Père"},{"greek":"ἥμαρτον","gloss":"j'ai_péché"},{"greek":"εἰς","gloss":"dans/contre"},{"greek":"τὸν","gloss":"le"},{"greek":"οὐρανὸν","gloss":"ciel"},{"greek":"καὶ","gloss":"et"},{"greek":"ἐνώπιόν","gloss":"devant"},{"greek":"σου,","gloss":"toi"}]},{"verse_number":19,"translations":{"segond":"je ne suis plus digne d'être appelé ton fils ; traite-moi comme l'un de tes mercenaires.","darby":"je ne suis plus digne d'être appelé ton fils ; traite-moi comme l'un de tes mercenaires."},"interlinear":[{"greek":"οὐκέτι","gloss":"plus"},{"greek":"εἰμὶ","gloss":"je_suis"},{"greek":"ἄξιος","gloss":"digne"},{"greek":"κληθῆναι","gloss":"d'être_appelé"},{"greek":"υἱός","gloss":"fils"},{"greek":"σου·","gloss":"de_toi"},{"greek":"ποίησόν","gloss":"fais/traite"},{"greek":"με","gloss":"moi"},{"greek":"ὡς","gloss":"comme"},{"greek":"ἕνα","gloss":"un"},{"greek":"τῶν","gloss":"des"},{"greek":"μισθίων","gloss":"mercenaires"},{"greek":"σου.","gloss":"de_toi"}]},{"verse_number":20,"translations":{"segon