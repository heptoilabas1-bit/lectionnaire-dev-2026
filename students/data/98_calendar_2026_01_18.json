s"},{"greek":"ἀόρατα","gloss":"invisibles"},{"greek":"εἴτε","gloss":"soit"},{"greek":"θρόνοι","gloss":"trônes"},{"greek":"εἴτε","gloss":"soit"},{"greek":"κυριότητες","gloss":"seigneuries"},{"greek":"εἴτε","gloss":"soit"},{"greek":"ἀρχαί","gloss":"principautés"},{"greek":"εἴτε","gloss":"soit"},{"greek":"ἐξουσίαι","gloss":"autorités"},{"greek":"τὰ","gloss":"les"},{"greek":"πάντα","gloss":"toutes_choses"},{"greek":"δι’","gloss":"par"},{"greek":"αὐτοῦ","gloss":"lui"},{"greek":"καὶ","gloss":"et"},{"greek":"εἰς","gloss":"pour"},{"greek":"αὐτὸν","gloss":"lui"},{"greek":"ἔκτισται·","gloss":"ont_été_créées"}]},{"verse_number":17,"translations":{"segond":"Il est avant toutes choses, et toutes choses subsistent en lui.","darby":"et lui est avant toutes choses, et toutes choses subsistent par lui ;"},"interlinear":[{"greek":"καὶ","gloss":"et"},{"greek":"αὐτός","gloss":"lui"},{"greek":"ἐστι","gloss":"est"},{"greek":"πρὸ","gloss":"avant"},{"greek":"πάντων","gloss":"toutes_choses"},{"greek":"καὶ","gloss":"et"},{"greek":"τὰ","gloss":"les"},{"greek":"πάντα","gloss":"toutes_choses"},{"greek":"ἐν","gloss":"en"},{"greek":"αὐτῷ","gloss":"lui"},{"greek":"συνέστηκε.","gloss":"subsistent."}]},{"verse_number":18,"translations":{"segond":"Il est la tête du corps de l’Église ; il est le commencement, le premier-né d’entre les morts, afin d’être en tout le premier.","darby":"et il est le chef du corps, de l’assemblée, lui qui est le commencement, le premier-né d’entre les morts, afin qu’en toutes choses il tienne, lui, la première place ;"},"interlinear":[{"greek":"καὶ","gloss":"Et"},{"greek":"αὐτός","gloss":"lui"},{"greek":"ἐστιν","gloss":"est"},{"greek":"ἡ","gloss":"la"},{"greek":"κεφαλὴ","gloss":"tête"},{"greek":"τοῦ","gloss":"du"},{"greek":"σώματος","gloss":"corps"},{"greek":"τῆς","gloss":"de_l'"},{"greek":"ἐκκλησίας·","gloss":"église;"},{"greek":"ὅς","gloss":"qui"},{"greek":"ἐστιν","gloss":"est"},{"greek":"ἀρχή,","gloss":"commencement,"},{"greek":"πρωτότοκος","gloss":"premier-né"},{"greek