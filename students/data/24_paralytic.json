e_number":"9, 35","translations":{"segond":"Tous les habitants de Lydde et du Saron le virent, et ils se convertirent au Seigneur.","darby":"Et tous ceux qui habitaient à Lydda et au Saron le virent ; et ils se tournèrent vers le Seigneur."},"interlinear":[{"greek":"καὶ","gloss":"Et"},{"greek":"εἶδον","gloss":"virent"},{"greek":"αὐτὸν","gloss":"lui"},{"greek":"πάντες","gloss":"tous"},{"greek":"οἱ","gloss":"ceux_qui"},{"greek":"κατοικοῦντες","gloss":"habitaient"},{"greek":"Λύδδα","gloss":"Lydda"},{"greek":"καὶ","gloss":"et"},{"greek":"τὸν","gloss":"le"},{"greek":"Σαρῶνα,","gloss":"Saron"},{"greek":"οἵτινες","gloss":"lesquels"},{"greek":"ἐπέστρεψαν","gloss":"se_tournèrent/se_convertirent"},{"greek":"ἐπὶ","gloss":"vers"},{"greek":"τὸν","gloss":"le"},{"greek":"κύριον.","gloss":"Seigneur"}]},{"verse_number":"9, 36","translations":{"segond":"Il y avait à Joppé, parmi les disciples, une femme nommée Tabitha, ce qui signifie Dorcas : elle faisait beaucoup de bonnes œuvres et d'aumônes.","darby":"Or il y avait à Joppé une certaine disciple nommée Tabitha, ce qui, traduit, se dit Dorcas : elle était pleine de bonnes œuvres et d'aumônes qu'elle faisait."},"interlinear":[{"greek":"Ἐν","gloss":"À"},{"greek":"Ἰόππῃ","gloss":"Joppé"},{"greek":"δέ","gloss":"or"},{"greek":"τις","gloss":"une_certaine"},{"greek":"ἦν","gloss":"était"},{"greek":"μαθήτρια","gloss":"disciple"},{"greek":"ὀνόματι","gloss":"de_nom"},{"greek":"Ταβιθά,","gloss":"Tabitha"},{"greek":"ἣ","gloss":"laquelle"},{"greek":"διερμηνευομένη","gloss":"étant_traduite"},{"greek":"λέγεται","gloss":"est_dite"},{"greek":"Δορκάς·","gloss":"Dorcas/Gazelle"},{"greek":"αὕτη","gloss":"celle-ci"},{"greek":"ἦν","gloss":"était"},{"greek":"πλήρης","gloss":"pleine"},{"greek":"ἔργων","gloss":"d'œuvres"},{"greek":"ἀγαθῶν","gloss":"bonnes"},{"greek":"καὶ","gloss":"et"},{"greek":"ἐλεημοσυνῶν","gloss":"d'aumônes"},{"greek":"ὧν","gloss":"lesquelles"},{"greek":"ἐποίει.","gloss":"elle_faisait"}]},{"verse_number":"9, 37","translations":{"segond":"Elle tomba malade en ce temps-là, et mourut. Après l'avoir lavée, on la déposa dans une chambre haute.","darby":"Et il arriva en ces jours-là, qu'elle tomba malade et mourut ; et quand ils l'eurent lavée, ils la mirent dans la chambre haute."},"interlinear":[{"greek":"ἐγένετο","gloss":"Il_arriva"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐν","gloss":"en"},{"greek":"ταῖς","gloss":"les"},{"greek":"ἡμέραις","gloss":"jours"},{"greek":"ἐκείναις","gloss":"ceux-là"},{"greek":"ἀσθενήσασαν","gloss":"étant_tombée_malade"},{"greek":"αὐτὴν","gloss":"elle"},{"greek":"ἀποθανεῖν·","gloss":"mourut"},{"greek":"λούσαντες","gloss":"l'ayant_lavée"},{"greek":"δὲ","gloss":"or"},{"greek":"ἔθηκαν","gloss":"ils_déposèrent"},{"greek":"ἐν","gloss":"dans"},{"greek":"ὑπερῴῳ.","gloss":"une_chambre_haute"}]},{"verse_number":"9, 38","translations":{"segond":"Comme Lydde est près de Joppé, les disciples, ayant appris que Pierre s'y trouvait, envoyèrent deux hommes vers lui, pour le prier de venir chez eux sans tarder.","darby":"Et comme Lydda était près de Joppé, les disciples, ayant appris que Pierre y était, envoyèrent vers lui deux hommes, le priant de ne pas tarder de venir jusque chez eux."},"interlinear":[{"greek":"ἐγγὺς","gloss":"Près"},{"greek":"δὲ","gloss":"or"},{"greek":"οὔσης","gloss":"étant"},{"greek":"Λύδδας","gloss":"Lydda"},{"greek":"τῇ","gloss":"de_la"},{"greek":"Ἰόππῃ","gloss":"Joppé"},{"greek":"οἱ","gloss":"les"},{"greek":"μαθηταὶ","gloss":"disciples"},{"greek":"ἀκούσαντες","gloss":"ayant_entendu"},{"greek":"ὅτι","gloss":"que"},{"greek":"Πέτρος","gloss":"Pierre"},{"greek":"ἐστὶν","gloss":"est"},{"greek":"ἐν","gloss":"dans"},{"greek":"αὐτῇ","gloss":"elle"},{"greek":"ἀπέστειλαν","gloss":"envoyèrent"},{"greek":"δύο","gloss":"deux"},{"greek":"ἄνδρας","gloss":"hommes"},{"greek":"πρὸς","gloss":"vers"},{"greek":"αὐτὸν","gloss":"lui"},{"greek":"παρακαλοῦντες·","gloss":"suppliant"},{"greek":"Μὴ","gloss":"Ne...pas"},{"greek":"ὀκνήσῃς","gloss":"hésite/tarde"},{"greek":"διελθεῖν","gloss":"à_passer"},{"greek":"ἕως","gloss":"jusqu'à"},{"greek":"ἡμῶν.","gloss":"nous"}]},{"verse_number":"9, 39","translations":{"segond":"Pierre se leva, et partit avec ces hommes. Lorsqu'il fut arrivé, on le conduisit dans la chambre haute. Toutes les veuves l'entourèrent en pleurant, et lui montrèrent les tuniques et les vêtements que faisait Dorcas pendant qu'elle était avec elles.","darby":"Et Pierre, s'étant levé, s'en alla avec eux. Quand il fut arrivé, ils le menèrent dans la chambre haute ; et toutes les veuves se présentèrent à lui en pleurant, et en montrant les tuniques et les vêtements que Dorcas faisait pendant qu'elle était avec elles."},"interlinear":[{"greek":"Ἀναστὰς","gloss":"s'étant_levé"},{"greek":"δὲ","gloss":"or"},{"greek":"Πέτρος","gloss":"Pierre"},{"greek":"συνῆλθεν","gloss":"alla_avec"},{"greek":"αὐτοῖς·","gloss":"eux"},{"greek":"ὃν","gloss":"lequel"},{"greek":"παραγενόμενον","gloss":"étant_arrivé"},{"greek":"ἀνήγαγον","gloss":"ils_firent_monter"},{"greek":"εἰς","gloss":"dans"},{"greek":"τὸ","gloss":"la"},{"greek":"ὑπερῷον,","gloss":"chambre_haute"},{"greek":"καὶ","gloss":"et"},{"greek":"παρέστησαν","gloss":"se_tinrent_auprès_de"},{"greek":"αὐτῷ","gloss":"lui"},{"greek":"πᾶσαι","gloss":"toutes"},{"greek":"αἱ","gloss":"les"},{"greek":"χῆραι","gloss":"veuves"},{"greek":"κλαίουσαι","gloss":"pleurant"},{"greek":"καὶ","gloss":"et"},{"greek":"ἐπιδεικνύμεναι","gloss":"montrant"},{"greek":"χιτῶνας","gloss":"des_tuniques"},{"greek":"καὶ","gloss":"et"},{"greek":"ἱμάτια","gloss":"des_vêtements"},{"greek":"ὅσα","gloss":"tout_ce_que"},{"greek":"ἐποίει","gloss":"faisait"},{"greek":"μετ’","gloss":"avec"},{"greek":"αὐτῶν","gloss":"elles"},{"greek":"οὖσα","gloss":"étant"},{"greek":"ἡ","gloss":"la"},{"greek":"Δορκάς.","gloss":"Dorcas"}]},{"verse_number":"9, 40","translations":{"segond":"Pierre fit sortir tout le monde, se mit à genoux, et pria; puis, se tournant vers le corps, il dit : Tabitha, lève-toi ! Elle ouvrit les yeux, et ayant vu Pierre, elle s'assit.","darby":"Et Pierre, les ayant tous mis dehors, et s'étant mis à genoux, pria ; et se tournant vers le corps, il dit : Tabitha, lève-toi. Et elle ouvrit ses yeux ; et voyant Pierre, elle s'assit."},"interlinear":[{"greek":"ἐκβαλὼν","gloss":"Ayant_mis_dehors"},{"greek":"δὲ","gloss":"or"},{"greek":"ἔξω","gloss":"dehors"},{"greek":"πάντας","gloss":"tous"},{"greek":"ὁ","gloss":"le"},{"greek":"Πέτρος","gloss":"Pierre"},{"greek":"καὶ","gloss":"et"},{"greek":"θεὶς","gloss":"ayant_posé"},{"greek":"τὰ","gloss":"les"},{"greek":"γόνατα","gloss":"genoux"},{"greek":"προσηύξατο,","gloss":"il_pria"},{"greek":"καὶ","gloss":"et"},{"greek":"ἐπιστρέψας","gloss":"s'étant_tourné"},{"greek":"πρὸς","gloss":"vers"},{"greek":"τὸ","gloss":"le"},{"greek":"σῶμα","gloss":"corps"},{"greek":"εἶπεν·","gloss":"dit"},{"greek":"Ταβιθά,","gloss":"Tabitha"},{"greek":"ἀνάστηθι.","gloss":"lève-toi"},{"greek":"ἡ","gloss":"Elle"},{"greek":"δὲ","gloss":"or"},{"greek":"ἤνοιξεν","gloss":"ouvrit"},{"greek":"τοὺς","gloss":"les"},{"greek":"ὀφθαλμοὺς","gloss":"yeux"},{"greek":"αὐτῆς,","gloss":"d'elle"},{"greek":"καὶ","gloss":"et"},{"greek":"ἰδοῦσα","gloss":"ayant_vu"},{"greek":"τὸν","gloss":"le"},{"greek":"Πέτρον","gloss":"Pierre"},{"greek":"ἀνεκάθισεν.","gloss":"elle_s'assit"}]},{"verse_number":"9, 41","translations":{"segond":"Il lui donna la main, et la fit lever. Il appela ensuite les saints et les veuves, et la leur présenta vivante.","darby":"Et il lui donna la main et la leva ; et ayant appelé les saints et les veuves, il la leur présenta vivante."},"interlinear":[{"greek":"δοὺς","gloss":"Ayant_donné"},{"greek":"δὲ","gloss":"or"},{"greek":"αὐτῇ","gloss":"à_elle"},{"greek":"χεῖρα","gloss":"la_main"},{"greek":"ἀνέστησεν","gloss":"il_la_fit_lever/la_releva"},{"greek":"αὐτήν,","gloss":"elle"},{"greek":"φωνήσας","gloss":"ayant_appelé"},{"greek":"δὲ","gloss":"or"},{"greek":"τοὺς","gloss":"les"},{"greek":"ἁγίους","gloss":"saints"},{"greek":"καὶ","gloss":"et"},{"greek":"τὰς","gloss":"les"},{"greek":"χήρας","gloss":"veuves"},{"greek":"παρέστησεν","gloss":"il_présenta"},{"greek":"αὐτὴν","gloss":"elle"},{"greek":"ζῶσαν.","gloss":"vivante"}]},{"verse_number":"9, 42","translations":{"segond":"Cela fut connu de tout Joppé, et beaucoup crurent au Seigneur.","darby":"Et cela fut connu dans tout Joppé ; et plusieurs crurent au Seigneur."},"interlinear":[{"greek":"γνωστὸν","gloss":"Connu"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐγένετο","gloss":"il_devint"},{"greek":"καθ’","gloss":"dans"},{"greek":"ὅλης","gloss":"toute"},{"greek":"τῆς","gloss":"la"},{"greek":"Ἰόππης,","gloss":"Joppé"},{"greek":"καὶ","gloss":"et"},{"greek":"ἐπίστευσαν","gloss":"crurent"},{"greek":"πολλοὶ","gloss":"beaucoup"},{"greek":"ἐπὶ","gloss":"en"},{"greek":"τὸν","gloss":"le"},{"greek":"κύριον.","gloss":"Seigneur"}]}]},"reading_connections":{"links":[]}}