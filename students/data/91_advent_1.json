is,","darby":"Et tous ceux-ci, ayant reçu témoignage par la foi, n'ont pas reçu la chose promise,"},"interlinear":[{"greek":"Καὶ","gloss":"Et"},{"greek":"οὗτοι","gloss":"ceux-ci"},{"greek":"πάντες","gloss":"tous"},{"greek":"μαρτυρηθέντες","gloss":"ayant_reçu_témoignage"},{"greek":"διὰ","gloss":"à_travers/par"},{"greek":"τῆς","gloss":"la"},{"greek":"πίστεως","gloss":"foi"},{"greek":"οὐκ","gloss":"ne...pas"},{"greek":"ἐκομίσαντο","gloss":"obtinrent/reçurent"},{"greek":"τὴν","gloss":"la"},{"greek":"ἐπαγγελίαν,","gloss":"promesse"}]},{"verse_number":40,"translations":{"segond":"Dieu ayant en vue quelque chose de meilleur pour nous, afin qu'ils ne parvinssent pas sans nous à la perfection.","darby":"Dieu ayant eu en vue quelque chose de meilleur pour nous, afin qu'ils ne parvinssent pas à la perfection sans nous."},"interlinear":[{"greek":"τοῦ","gloss":"le"},{"greek":"θεοῦ","gloss":"Dieu"},{"greek":"περὶ","gloss":"au_sujet_de"},{"greek":"ἡμῶν","gloss":"nous"},{"greek":"κρεῖττόν","gloss":"de_meilleur"},{"greek":"τι","gloss":"quelque_chose"},{"greek":"προβλεψαμένου,","gloss":"ayant_prévu/pourvu"},{"greek":"ἵνα","gloss":"afin_que"},{"greek":"μὴ","gloss":"ne...pas"},{"greek":"χωρὶς","gloss":"séparément_de/sans"},{"greek":"ἡμῶν","gloss":"nous"},{"greek":"τελειωθῶσιν.","gloss":"ils_parvinssent_à_la_perfection/achèvement"}]}]},"reading_connections":{"links":[]}}