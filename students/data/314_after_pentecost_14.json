"},{"greek":"πῶς","gloss":"comment"},{"greek":"εἰσῆλθες","gloss":"es-tu_entré"},{"greek":"ὧδε","gloss":"ici"},{"greek":"μὴ","gloss":"ne...pas"},{"greek":"ἔχων","gloss":"ayant"},{"greek":"ἔνδυμα","gloss":"habit"},{"greek":"γάμου;","gloss":"de_noces"},{"greek":"ὁ","gloss":"Lui"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐφιμώθη.","gloss":"fut_réduit_au_silence"}]},{"verse_number":13,"translations":{"segond":"Alors le roi dit aux serviteurs : Liez-lui les pieds et les mains, et jetez-le dans les ténèbres du dehors, où il y aura des pleurs et des grincements de dents.","darby":"Alors le roi dit aux serviteurs : Liez-lui les pieds et les mains, emportez-le, et jetez-le dans les ténèbres de dehors : là seront les pleurs et les grincements de dents."},"interlinear":[{"greek":"τότε","gloss":"Alors"},{"greek":"ὁ","gloss":"le"},{"greek":"βασιλεὺς","gloss":"roi"},{"greek":"εἶπεν","gloss":"dit"},{"greek":"τοῖς","gloss":"aux"},{"greek":"διακόνοις·","gloss":"serviteurs"},{"greek":"Δήσαντες","gloss":"Ayant_lié"},{"greek":"αὐτοῦ","gloss":"de_lui"},{"greek":"πόδας","gloss":"les_pieds"},{"greek":"καὶ","gloss":"et"},{"greek":"χεῖρας","gloss":"les_mains"},{"greek":"ἐκβάλετε","gloss":"jetez"},{"greek":"αὐτὸν","gloss":"le"},{"greek":"εἰς","gloss":"dans"},{"greek":"τὸ","gloss":"les"},{"greek":"σκότος","gloss":"ténèbres"},{"greek":"τὸ","gloss":"les"},{"greek":"ἐξώτερον·","gloss":"extérieures"},{"greek":"ἐκεῖ","gloss":"là"},{"greek":"ἔσται","gloss":"sera/seront"},{"greek":"ὁ","gloss":"les"},{"greek":"κλαυθμὸς","gloss":"pleurs"},{"greek":"καὶ","gloss":"et"},{"greek":"ὁ","gloss":"les"},{"greek":"βρυγμὸς","gloss":"grincements"},{"greek":"τῶν","gloss":"des"},{"greek":"ὀδόντων.","gloss":"dents"}]},{"verse_number":14,"translations":{"segond":"Car il y a beaucoup d'appelés, mais peu d'élus.","darby":"Car il y a beaucoup d'appelés, mais peu d'élus."},"interlinear":[{"greek":"πολλοὶ","gloss":"Beaucoup"},{"greek":"γάρ","gloss":"car"},{"greek":"εἰσιν","gloss":"sont"},{"greek":"κλητοὶ","gloss":"appelés"},{"greek":"ὀλίγοι","gloss":"peu"},{"greek":"δὲ","gloss":"or/mais"},{"greek":"ἐκλεκτοί.","gloss":"élus"}]}]},"apostle":{"reference":"2 Corinthiens 1, 21 - 2, 4","title":"Le sceau de l'Esprit et la sollicitude de Paul","interlinear":[{"verse_number":21,"translations":{"segond":"Celui qui nous affermit avec vous en Christ, et qui nous a oints, c'est Dieu,","darby":"Or celui qui nous affermit avec vous en Christ, et qui nous a oints, c'est Dieu,"},"interlinear":[{"greek":"ὁ","gloss":"Celui"},{"greek":"δὲ","gloss":"or"},{"greek":"βεβαιῶν","gloss":"affermissant/rendant_ferme"},{"greek":"ἡμᾶς","gloss":"nous"},{"greek":"σὺν","gloss":"avec"},{"greek":"ὑμῖν","gloss":"vous"},{"greek":"εἰς","gloss":"en/pour"},{"greek":"Χριστὸν","gloss":"Christ"},{"greek":"καὶ","gloss":"et"},{"greek":"χρίσας","gloss":"ayant_oints"},{"greek":"ἡμᾶς","gloss":"nous"},{"greek":"θεός,","gloss":"Dieu"}]},{"verse_number":22,"translations":{"segond":"lequel nous a aussi marqués d'un sceau et a mis dans nos cœurs les arrhes de l'Esprit.","darby":"qui aussi nous a scellés, et nous a donné les arrhes de l'Esprit dans nos coeurs."},"interlinear":[{"greek":"ὁ","gloss":"Lequel"},{"greek":"καὶ","gloss":"aussi"},{"greek":"σφραγισάμενος","gloss":"ayant_scellés"},{"greek":"ἡμᾶς","gloss":"nous"},{"greek":"καὶ","gloss":"et"},{"greek":"δοὺς","gloss":"ayant_donné"},{"greek":"τὸν","gloss":"les"},{"greek":"ἀρραβῶνα","gloss":"arrhes/acompte"},{"greek":"τοῦ","gloss":"de_l'"},{"greek":"πνεύματος","gloss":"Esprit"},{"greek":"ἐν","gloss":"dans"},{"greek":"ταῖς","gloss":"les"},{"greek":"καρδίαις","gloss":"cœurs"},{"greek":"ἡμῶν.","gloss":"de_nous"}]},{"verse_number":23,"translations":{"segond":"Or, je prends Dieu à témoin sur mon âme, que c'est pour vous épargner que je ne suis plus allé à Corinthe ;","darby":"Or j'appelle Dieu à témoin sur mon âme, que c'est pour vous épargner que je ne suis pas encore allé à Corinthe ;"},"interlinear":[{"greek":"Ἐγὼ","gloss":"Moi"},{"greek":"δὲ","gloss":"or"},{"greek":"μάρτυρα","gloss":"témoin"},{"greek":"τὸν","gloss":"le"},{"greek":"θεὸν","gloss":"Dieu"},{"greek":"ἐπικαλοῦμαι","gloss":"j'invoque"},{"greek":"ἐπὶ","gloss":"sur"},{"greek":"τὴν","gloss":"la"},{"greek":"ἐμὴν","gloss":"mienne"},{"greek":"ψυχήν,","gloss":"âme"},{"greek":"ὅτι","gloss":"que"},{"greek":"φειδόμενος","gloss":"épargnant"},{"greek":"ὑμῶν","gloss":"vous"},{"greek":"οὐκέτι","gloss":"ne...plus/pas_encore"},{"greek":"ἦλθον","gloss":"je_suis_allé"},{"greek":"εἰς","gloss":"à"},{"greek":"Κόρινθον.","gloss":"Corinthe"}]},{"verse_number":24,"translations":{"segond":"non pas que nous dominions sur votre foi, mais nous contribuons à votre joie, car vous êtes fermes dans la foi.","darby":"non que nous dominions sur votre foi, mais nous sommes collaborateurs de votre joie ; car vous êtes debout par la foi."},"interlinear":[{"greek":"οὐχ","gloss":"Non"},{"greek":"ὅτι","gloss":"que"},{"greek":"κυριεύομεν","gloss":"nous_dominons"},{"greek":"ὑμῶν","gloss":"de_vous"},{"greek":"τῆς","gloss":"sur_la"},{"greek":"πίστεως,","gloss":"foi"},{"greek":"ἀλλὰ","gloss":"mais"},{"greek":"συνεργοί","gloss":"collaborateurs/synerges"},{"greek":"ἐσμεν","gloss":"nous_sommes"},{"greek":"τῆς","gloss":"de_la"},{"greek":"χαρᾶς","gloss":"joie"},{"greek":"ὑμῶν·","gloss":"de_vous"},{"greek":"τῇ","gloss":"par_la"},{"greek":"γὰρ","gloss":"car"},{"greek":"πίστει","gloss":"foi"},{"greek":"ἑστήκατε.","gloss":"vous_êtes_debout/fermes"}]},{"verse_number":1,"translations":{"segond":"Je résolus donc en moi-même de ne pas retourner chez vous dans la tristesse.","darby":"Or j'ai jugé ceci en moi-même, de ne pas retourner vers vous avec de la tristesse."},"interlinear":[{"greek":"Ἔκρινα","gloss":"J'ai_jugé/résolu"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐμαυτῷ","gloss":"en_moi-même"},{"greek":"τοῦτο,","gloss":"ceci"},{"greek":"τὸ","gloss":"le"},{"greek":"μὴ","gloss":"ne...pas"},{"greek":"πάλιν","gloss":"de_nouveau"},{"greek":"ἐν","gloss":"dans"},{"greek":"λύπῃ","gloss":"tristesse"},{"greek":"πρὸς","gloss":"vers"},{"greek":"ὑμᾶς","gloss":"vous"},{"greek":"ἐλθεῖν.","gloss":"venir"}]},{"verse_number":2,"translations":{"segond":"Car si je vous attriste, qui donc me réjouira, sinon celui qui est attristé par moi ?","darby":"Car si moi je vous attriste, qui est-ce qui me réjouit, sinon celui qui est attristé par moi ?"},"interlinear":[{"greek":"εἰ","gloss":"Si"},{"greek":"γὰρ","gloss":"car"},{"greek":"ἐγὼ","gloss":"moi"},{"greek":"λυπῶ","gloss":"j'attriste"},{"greek":"ὑμᾶς,","gloss":"vous"},{"greek":"καὶ","gloss":"et"},{"greek":"τίς","gloss":"qui"},{"greek":"ὁ","gloss":"celui"},{"greek":"εὐφραίνων","gloss":"réjouissant"},{"greek":"με","gloss":"moi"},{"greek":"εἰ","gloss":"si"},{"greek":"μὴ","gloss":"ce_n'est"},{"greek":"ὁ","gloss":"celui"},{"greek":"λυπούμενος","gloss":"étant_attristé"},{"greek":"ἐξ","gloss":"par"},{"greek":"ἐμοῦ;","gloss":"moi"}]},{"verse_number":3,"translations":{"segond":"J'ai écrit comme je l'ai fait, afin de ne pas éprouver, à mon arrivée, de la tristesse de la part de ceux qui devaient me donner de la joie, ayant en vous tous cette confiance que ma joie est la vôtre à tous.","darby":"Et je vous ai écrit cela même, afin que, quand j'arriverai, je n'aie pas de tristesse de la part de ceux de qui je devais me réjouir ; me confiant en vous tous que ma joie est la vôtre à tous."},"interlinear":[{"greek":"καὶ","gloss":"Et"},{"greek":"ἔγραψα","gloss":"j'ai_écrit"},{"greek":"τοῦτο","gloss":"cela"},{"greek":"αὐτό,","gloss":"même"},{"greek":"ἵνα","gloss":"afin_que"},{"greek":"μὴ","gloss":"ne...pas"},{"greek":"ἐλθὼν","gloss":"étant_venu"},{"greek":"λύπην","gloss":"tristesse"},{"greek":"σχῶ","gloss":"j'aie"},{"greek":"ἀφ’","gloss":"de_la_part_de"},{"greek":"ὧν","gloss":"ceux_dont"},{"greek":"ἔδει","gloss":"il_fallait"},{"greek":"με","gloss":"que_je"},{"greek":"χαίρειν,","gloss":"me_réjouisse"},{"greek":"πεποιθὼς","gloss":"me_confiant/ayant_confiance"},{"greek":"ἐπὶ","gloss":"en/sur"},{"greek":"πάντας","gloss":"tous"},{"greek":"ὑμᾶς","gloss":"vous"},{"greek":"ὅτι","gloss":"que"},{"greek":"ἡ","gloss":"la"},{"greek":"ἐμὴ","gloss":"mienne"},{"greek":"χαρὰ","gloss":"joie"},{"greek":"πάντων","gloss":"de_tous"},{"greek":"ὑμῶν","gloss":"vous"},{"greek":"ἐστιν.","gloss":"est"}]},{"verse_number":4,"translations":{"segond":"C'est dans une grande affliction, le cœur angoissé, et avec beaucoup de larmes, que je vous ai écrit, non pas afin que vous fussiez attristés, mais afin que vous connussiez l'amour extrême que j'ai pour vous.","darby":"Car, dans une grande tribulation et un grand serrement de coeur, je vous ai écrit avec beaucoup de larmes, non afin que vous fussiez attristés, mais afin que vous connussiez l'amour que j'ai si abondamment pour vous."},"interlinear":[{"greek":"ἐκ","gloss":"À_partir_de"},{"greek":"γὰρ","gloss":"car"},{"greek":"πολλῆς","gloss":"beaucoup_de"},{"greek":"θλίψεως","gloss":"pression/tribulation"},{"greek":"καὶ","gloss":"et"},{"greek":"συνοχῆς","gloss":"angoisse/serrement"},{"greek":"καρδίας","gloss":"de_cœur"},{"greek":"ἔγραψα","gloss":"j'ai_écrit"},{"greek":"ὑμῖν","gloss":"à_vous"},{"greek":"διὰ","gloss":"à_travers"},{"greek":"πολλῶν","gloss":"beaucoup_de"},{"greek":"δακρύων,","gloss":"larmes"},{"greek":"οὐχ","gloss":"non"},{"greek":"ἵνα","gloss":"afin_que"},{"greek":"λυπηθῆτε,","gloss":"vous_soyez_attristés"},{"greek":"ἀλλὰ","gloss":"mais"},{"greek":"τὴν","gloss":"l'"},{"greek":"ἀγάπην","gloss":"amour"},{"greek":"ἵνα","gloss":"afin_que"},{"greek":"γνῶτε","gloss":"vous_connaissiez"},{"greek":"ἣν","gloss":"lequel"},{"greek":"ἔχω","gloss":"j'ai"},{"greek":"περισσοτέρως","gloss":"abondamment/extrêmement"},{"greek":"εἰς","gloss":"envers"},{"greek":"ὑμᾶς.","gloss":"vous"}]}]},"reading_connections":{"title":"Comparer les mots grecs","summary":"","links":[{"kind":"same_root","directness":"direct","link_type":"divine_call","title":"Mot ou racine grecque commune","gospel":{"verses":[],"terms":["καλέσαι","κεκλημένους","καλέσατε","κλητοὶ"]},"apostle":{"verses":[],"terms":["ἐπικαλοῦμαι"]},"term_details":{"gospel":[{"forms":["καλέσαι","κεκλημένους",