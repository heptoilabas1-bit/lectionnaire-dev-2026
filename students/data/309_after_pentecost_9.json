eek":"δὲ","gloss":"or"},{"greek":"μαθηταὶ","gloss":"disciples"},{"greek":"ἰδόντες","gloss":"ayant_vu"},{"greek":"αὐτὸν","gloss":"lui"},{"greek":"ἐπὶ","gloss":"sur"},{"greek":"τῆς","gloss":"la"},{"greek":"θαλάσσης","gloss":"mer"},{"greek":"περιπατοῦντα","gloss":"marchant"},{"greek":"ἐταράχθησαν","gloss":"furent_troublés/terrifiés"},{"greek":"λέγοντες","gloss":"disant"},{"greek":"ὅτι","gloss":"que"},{"greek":"Φάντασμά","gloss":"Un_fantôme"},{"greek":"ἐστιν,","gloss":"c'est"},{"greek":"καὶ","gloss":"et"},{"greek":"ἀπὸ","gloss":"de"},{"greek":"τοῦ","gloss":"la"},{"greek":"φόβου","gloss":"peur"},{"greek":"ἔκραξαν.","gloss":"ils_crièrent"}]},{"verse_number":27,"translations":{"segond":"Jésus leur dit aussitôt: Rassurez-vous, c'est moi; n'ayez pas peur!","darby":"Mais Jésus leur parla aussitôt, disant : Ayez bon courage ; c'est moi, n'ayez point de peur."},"interlinear":[{"greek":"εὐθὺς","gloss":"Aussitôt"},{"greek":"δὲ","gloss":"or"},{"greek":"ἐλάλησεν","gloss":"parla"},{"greek":"ὁ","gloss":"le"},{"greek":"Ἰησοῦς","gloss":"Jésus"},{"greek":"αὐτοῖς","gloss":"à_eux"},{"greek":"λέγων·","gloss":"disant"},{"greek":"Θαρσεῖτε,","gloss":"Prenez_courage"},{"greek":"ἐγώ","gloss":"Moi"},{"greek":"εἰμι·","gloss":"Je_suis"},{"greek":"μὴ","gloss":"ne...pas"},{"greek":"φοβεῖσθε.","gloss":"ayez_peur"}]},{"verse_number":28,"translations":{"segond":"Pierre lui répondit: Seigneur, si c'est toi, ordonne que j'aille vers toi sur les eaux.","darby":"Et Pierre, lui répondant, dit : Seigneur, si c'est toi, ordonne-moi d'aller vers toi sur les eaux."},"interlinear":[{"greek":"ἀποκριθεὶς","gloss":"Ayant_répondu"},{"greek":"δὲ","gloss":"or"},{"greek":"αὐτῷ","gloss":"à_lui"},{"greek":"ὁ","gloss":"le"},{"greek":"Πέτρος","gloss":"Pierre"},{"greek":"εἶπεν·","gloss":"dit"},{"greek":"Κύριε,","gloss":"Seigneur"},{"greek":"εἰ","gloss":"si"},{"greek":"σὺ","gloss":"toi"},{"greek":"εἶ,","gloss":"tu_es"},{"greek":"κέλευσόν","gloss":"ordonne"},{"greek":"με","gloss":"moi"},{"greek":"ἐλθεῖν","gloss":"d'aller"},{"