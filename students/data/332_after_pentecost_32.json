k":"τοῦ","gloss":"de_l'"},{"greek":"ἀνθρώπου","gloss":"homme"},{"greek":"ζητῆσαι","gloss":"chercher"},{"greek":"καὶ","gloss":"et"},{"greek":"σῶσαι","gloss":"sauver/unifier"},{"greek":"τὸ","gloss":"ce_qui"},{"greek":"ἀπολωλός.","gloss":"était_perdu/détruit"}]}]},"apostle":{"reference":"1 Timothée 4, 9-15","title":"Sois un modèle pour les fidèles","interlinear":[{"verse_number":9,"translations":{"segond":"C'est une parole certaine et entièrement digne d'être reçue.","darby":"Cette parole est certaine et digne de toute acceptation."},"interlinear":[{"greek":"Πιστὸς","gloss":"Fidèle/Certaine"},{"greek":"ὁ","gloss":"le"},{"greek":"λόγος","gloss":"Logos/Parole"},{"greek":"καὶ","gloss":"et"},{"greek":"πάσης","gloss":"de_toute"},{"greek":"ἀποδοχῆς","gloss":"réception/acceptation"},{"greek":"ἄξιος·","gloss":"digne/qui_a_du_poids"}]},{"verse_number":10,"translations":{"segond":"Nous travaillons, en effet, et nous combattons, parce que nous mettons notre espérance dans le Dieu vivant, qui est le Sauveur de tous les hommes, principalement des croyants.","darby":"Car c'est pour cela que nous travaillons et que nous sommes en opprobre, parce que nous espérons dans le Dieu vivant, qui est le conservateur de tous les hommes, spécialement des croyants."},"interlinear":[{"greek":"εἰς","gloss":"Vers/Pour"},{"greek":"τοῦτο","gloss":"cela"},{"greek":"γὰρ","gloss":"en_effet/car"},{"greek":"κοπιῶμεν","gloss":"nous_travaillons_durement/nous_nous_épuisons"},{"greek":"καὶ","gloss":"et"},{"greek":"ὀνειδιζόμεθα,","gloss":"nous_sommes_insultés/subissons_l'opprobre"},{"greek":"ὅτι","gloss":"parce_que"},{"greek":"ἠλπίκαμεν","gloss":"nous_avons_mis_notre_espérance"},{"greek":"ἐπὶ","gloss":"sur"},{"greek":"θεῷ","gloss":"Dieu"},{"greek":"ζῶντι,","gloss":"vivant"},{"greek":"ὅς","gloss":"qui"},{"greek":"ἐστιν","gloss":"est"},{"greek":"σωτὴρ","gloss":"Sauveur/Unificateur"},{"greek":"πάντων","gloss":"de_tous"},{"greek":"ἀνθρώπων,","gloss":"les_hommes"},{"greek":"μάλιστα","gloss":"surtout/principalement"},{"greek":"πιστῶν.","gloss":"des_croyants"}]},{"verse_number":11,"translations":{"segond":"Déclare ces choses, et enseigne-les.","darby":"Ordonne ces choses et enseigne-les."},"interlinear":[{"greek":"Παράγγελλε","gloss":"Ordonne/Transmets"},{"greek":"ταῦτα","gloss":"ces_choses"},{"greek":"καὶ","gloss":"et"},{"greek":"δίδασκε.","gloss":"enseigne"}]},{"verse_number":12,"translations":{"segond":"Que personne ne méprise ta jeunesse ; mais sois un modèle pour les fidèles, en parole, en conduite, en charité, en foi, en pureté.","darby":"Que personne ne méprise ta jeunesse ; mais sois le modèle des croyants, en parole, en conduite, en amour, en foi, en pureté."},"interlinear":[{"greek":"μηδείς","gloss":"Que_personne"},{"greek":"σου","gloss":"de_toi"},{"greek":"τῆς","gloss":"la"},{"greek":"νεότητος","gloss":"jeunesse"},{"greek":"καταφρονείτω,","gloss":"ne_méprise/ne_regarde_de_haut"},{"greek":"ἀλλὰ","gloss":"mais"},{"greek":"τύπος","gloss":"modèle/empreinte"},{"greek":"γίνου","gloss":"deviens/sois"},{"greek":"τῶν","gloss":"des"},{"greek":"πιστῶν,","gloss":"croyants"},{"greek":"ἐν","gloss":"en/dans"},{"greek":"λόγῳ,","gloss":"parole"},{"greek":"ἐν","gloss":"en"},{"greek":"ἀναστροφῇ,","gloss":"conduite/mouvement"},{"greek":"ἐν","gloss":"en"},{"greek":"ἀγάπῃ,","gloss":"amour/charité"},{"greek":"ἐν","gloss":"en"},{"greek":"πίστει,","gloss":"foi"},{"greek":"ἐν","gloss":"en"},{"greek":"ἁγνείᾳ.","gloss":"pureté"}]},{"verse_number":13,"translations":{"segond":"Jusqu'à ce que je vienne, applique-toi à la lecture, à l'exhortation, à l'enseignement.","darby":"Jusqu'à ce que je vienne, attache-toi à la lecture, à l'exhortation, à l'enseignement."},"interlinear":[{"greek":"ἕως","gloss":"Jusqu'à_ce_que"},{"greek":"ἔρχομαι","gloss":"je_vienne"},{"greek":"πρόσεχε","gloss":"applique-toi/porte_ton_attention"},{"greek":"τῇ","gloss":"à_la"},{"greek":"ἀναγνώσει,","gloss":"lecture/re-connaissance"},{"greek":"τῇ","gloss":"à_l'"},{"greek":"παρακλήσει,","gloss":"exhortation/consolation"},{"greek"